# Spring Boot runtime
PORT=8080

# Database
# For Supabase, use the JDBC Session Pooler connection string from the Supabase Connect dialog.
# Keep the password out of Git. The JDBC URL should include sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?user=postgres.<project-ref>&password=<database-password>&sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<database-password>

# Authentication
# Generate a long random secret (at least 32 bytes) for production.
JWT_SECRET=<long-random-jwt-secret>

# Browser origin allowed by the API.
FRONTEND_URL=http://localhost:5173
